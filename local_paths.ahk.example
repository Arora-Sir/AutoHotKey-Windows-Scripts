; Example Local Machine Paths Configuration
; Copy or rename this file to "local_paths.ahk" in the root directory.
; "local_paths.ahk" is automatically ignored by Git to protect your privacy and personal folder locations.

PATH_JAVA_COURSE := "D:\Path\To\Your\Java\Course"
PATH_IP_ROTATOR := "D:\Path\To\Your\Scripts\ROTATE.bat"

; GravityBridge Proxy Server Paths
PATH_GRAVITY_BRIDGE := "D:\Path\To\Your\Gravity-Bridge"
PATH_COPYCLIP := "D:\Path\To\Your\CopyClip"
PATH_PYTHON_EXE := "C:\Python314\pythonw.exe"

; Watchdog: apps to auto-relaunch if they crash or close. Add one entry per app.
WATCHDOG_APPS := [{name: "ExampleApp.exe", path: "D:\Path\To\Your\ExampleApp.exe"}]

