; Example Local Machine Paths Configuration
; Copy or rename this file to "local_paths.ahk" in the root directory.
; "local_paths.ahk" is automatically ignored by Git to protect your privacy and personal folder locations.

PATH_JAVA_COURSE := "D:\Path\To\Your\Java\Course"
PATH_IP_ROTATOR := "D:\Path\To\Your\Scripts\ROTATE.bat"

; GravityBridge Proxy Server Paths
PATH_GRAVITY_BRIDGE := "D:\Path\To\Your\Gravity-Bridge"
PATH_COPYCLIP := "D:\Path\To\Your\CopyClip"
PATH_PYTHON_EXE := "C:\Python314\pythonw.exe"

; Watchdog: apps to auto-relaunch if they crash or close. Add one entry per app.
; Wrap path in quotes if arguments are included (e.g. """C:\Path\App.exe"" --arg").
WATCHDOG_APPS := [ {name: "TrafficMonitor.exe", path: "D:\Path\To\TrafficMonitor.exe"}
				 , {name: "ssn.exe",           path: "C:\Program Files (x86)\Simnet\Simple Sticky Notes\ssn.exe"}
				 , {name: "Monica.exe",        path: "C:\Program Files\Monica\Monica.exe"}
				 , {name: "GoogleDriveFS.exe", path: """C:\Program Files\Google\Drive File Stream\129.0.1.0\GoogleDriveFS.exe"" --startup_mode"}
				 , {name: "Fences.exe",        path: """C:\Program Files (x86)\Stardock\Fences\Fences.exe"" /startup"} ]

; Sefirah (Phone Link alternative) Sleep Auto-Reconnect
; Space-separated "ip:port" list of wireless ADB targets (e.g. "192.168.1.50:5555" or "100.x.y.z:5555")
PATH_ADB_EXE := "D:\Path\To\Your\adb.exe"
SEFIRAH_ADB_TARGETS := "192.168.1.50:5555"
