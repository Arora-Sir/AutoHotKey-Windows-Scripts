#!/bin/sh
# Pre-commit hook: blocks commits that would leak THIS machine's local username/computer name or per-user Windows paths into this PUBLIC repo.
# Also warns (non-blocking) if a gitignored local-config file has grown new variables/keys that its tracked .example counterpart hasn't caught up to.
#
# Fully generic and safe to be public: derives the sensitive strings to check for from THIS machine's own environment at commit time ($USERNAME/$COMPUTERNAME), never hardcodes anyone's actual username or machine name into this tracked file.
# See ARCHITECTURE.md for the full design rationale (why a hook that hardcoded those values would itself be the exact leak it's meant to prevent).

export LC_ALL=C.UTF-8
export LANG=C.UTF-8

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# --- 1. Hard block: the 3 gitignored real-config files must never be staged ---
REAL_CONFIG_FILES="AllScripts/LocalPaths.ahk AllScripts/PersonalKeywords.ahk AllScripts/PowerShell/ssd_config.json"
for f in $REAL_CONFIG_FILES; do
    if echo "$STAGED_FILES" | grep -qxF "$f"; then
        echo "BLOCKED: '$f' is a gitignored local-config file and must never be committed." >&2
        echo "If this was staged with 'git add -f' intentionally, use 'git commit --no-verify'." >&2
        exit 1
    fi
done

# --- 2. Hard block: personal path/identity strings in any OTHER staged file ---
WIN_USER="${USERNAME:-$USER}"
WIN_COMPUTERNAME="${COMPUTERNAME:-}"
LEAK_FOUND=0

for f in $STAGED_FILES; do
    CONTENT=$(git show ":$f" 2>/dev/null)
    if [ -z "$CONTENT" ]; then
        continue
    fi

    if [ -n "$WIN_USER" ] && [ "${#WIN_USER}" -ge 3 ]; then
        if echo "$CONTENT" | grep -qF "$WIN_USER"; then
            echo "BLOCKED: staged file '$f' contains this machine's username ('$WIN_USER')." >&2
            LEAK_FOUND=1
        fi
    fi

    if [ -n "$WIN_COMPUTERNAME" ] && [ "${#WIN_COMPUTERNAME}" -ge 3 ]; then
        if echo "$CONTENT" | grep -qF "$WIN_COMPUTERNAME"; then
            echo "BLOCKED: staged file '$f' contains this machine's computer name ('$WIN_COMPUTERNAME')." >&2
            LEAK_FOUND=1
        fi
    fi

    if echo "$CONTENT" | grep -qE 'C:\\Users\\[^\\/"]+\\'; then
        echo "BLOCKED: staged file '$f' contains a hardcoded C:\\Users\\<name>\\ path." >&2
        LEAK_FOUND=1
    fi
done

if [ "$LEAK_FOUND" -eq 1 ]; then
    echo "" >&2
    echo "Route real paths through AllScripts/LocalPaths.ahk (gitignored) instead," >&2
    echo "and mirror the same variable name with a generic placeholder into the" >&2
    echo "tracked AllScripts/LocalPaths.ahk.example. See ARCHITECTURE.md." >&2
    echo "Use 'git commit --no-verify' only if you are certain this is intentional." >&2
    exit 1
fi

# --- 3. Hard block: em-dashes (—, –) and double hyphens (--) in staged comments/markdown ---
# Banned as AI slop and prohibited punctuation. Normal human writing uses colons, commas,
# parentheses, or standard sentence stops (periods).
EM_DASH_PATTERN='—|–|[[:space:]]--[[:space:]]|[[:alnum:]]--[[:alnum:]]|[[:space:]]--(\r?)$'
EM_DASH_FOUND=0

for f in $STAGED_FILES; do
    # 3a. Skip third-party or vendored paths
    case "$f" in
        vendor/*|third_party/*|external/*|node_modules/*)
            continue
            ;;
    esac

    # 3b. Skip paths matched in .lintignore if present
    if [ -f ".lintignore" ] && grep -qxF "$f" ".lintignore" 2>/dev/null; then
        continue
    fi

    case "$f" in
        *.ahk|*.ps1|*.py|*.cs|*.java|*.kt|*.kts|*.c|*.cpp|*.h|*.hpp|*.js|*.jsx|*.ts|*.tsx|*.go|*.rs|*.swift|*.dart|*.md|*.txt)
            CONTENT=$(git show ":$f" 2>/dev/null)
            if [ -z "$CONTENT" ]; then
                continue
            fi

            # 3c. Skip file if marked as generated, vendored, or explicitly exempt in header
            if echo "$CONTENT" | head -n 5 | grep -qE '(@generated|@vendored|<!-- no-dash-lint -->)'; then
                continue
            fi

            # 3d. Check for violations, excluding lines with inline escape hatch 'no-dash-lint'
            MATCHES=$(echo "$CONTENT" | grep -v 'no-dash-lint' | grep -nE "$EM_DASH_PATTERN")
            if [ -n "$MATCHES" ]; then
                echo "BLOCKED: staged file '$f' contains prohibited em-dashes or double-hyphens (--):" >&2
                echo "$MATCHES" | head -n 5 | sed 's/^/  line /' >&2
                EM_DASH_FOUND=1
            fi
            ;;
    esac
done

if [ "$EM_DASH_FOUND" -eq 1 ]; then
    echo "" >&2
    echo "To auto-fix all staged files, run: python scripts/clean_dashes.py --staged (or tell the AI 'fix dashes')." >&2
    echo "To exempt a specific line, append 'no-dash-lint' (e.g. '; no-dash-lint')." >&2
    echo "To exempt a third-party file, place it in vendor/ or add '@vendored' at the top." >&2
    echo "Use 'git commit --no-verify' only if you are certain this is intentional." >&2
    exit 1
fi

# --- 4. Soft warning only (does not block): real config vs. tracked .example drift ---
# $4 (optional) is a sed cleanup applied to each match, e.g. to strip a trailing ":" so a JSON "key": pattern compares as just the bare key name.
# (The colon has to stay in the match pattern itself, to distinguish a KEY from an ordinary quoted VALUE, since plain -E has no lookahead.)
check_sync() {
    real="$1"
    example="$2"
    pattern="$3"
    cleanup="${4:-cat}"
    if [ ! -f "$real" ] || [ ! -f "$example" ]; then
        return 0
    fi
    real_vars=$(grep -oE "$pattern" "$real" 2>/dev/null | eval "$cleanup" | sort -u)
    example_vars=$(grep -oE "$pattern" "$example" 2>/dev/null | eval "$cleanup" | sort -u)
    missing=$(comm -23 <(echo "$real_vars") <(echo "$example_vars") 2>/dev/null)
    if [ -n "$missing" ]; then
        echo "WARNING: '$real' has entries not yet mirrored in '$example':" >&2
        echo "$missing" >&2
        echo "(non-blocking - mirror them with a generic placeholder value when convenient)" >&2
    fi
}

REPO_ROOT=$(git rev-parse --show-toplevel)
# Note: intentionally plain -E (POSIX extended regex, no lookahead - not portable across grep implementations either way).
# Matches the leading identifier only; good enough for a non-blocking drift warning, not a strict parser.
check_sync "$REPO_ROOT/AllScripts/LocalPaths.ahk" "$REPO_ROOT/AllScripts/LocalPaths.ahk.example" '^[A-Za-z_][A-Za-z0-9_]*'
check_sync "$REPO_ROOT/AllScripts/PersonalKeywords.ahk" "$REPO_ROOT/AllScripts/PersonalKeywords.ahk.example" '^[A-Za-z_][A-Za-z0-9_]*'
check_sync "$REPO_ROOT/AllScripts/PowerShell/ssd_config.json" "$REPO_ROOT/AllScripts/PowerShell/ssd_config.json.example" '"[A-Za-z_][A-Za-z0-9_]*"[[:space:]]*:' "sed 's/[[:space:]]*:\$//'"

exit 0
